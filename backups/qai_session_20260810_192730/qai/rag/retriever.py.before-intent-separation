from vector_memory.search import search
from knowledge.search.search import search_engine
from learning.datasets.retriever import learning_retriever


SOURCE_PRIORITY = {
    "qai_learning": 300,
    "knowledge": 200,
    "vector": 100,
}


class Retriever:

    # =========================================================
    # NORMALIZATION
    # =========================================================

    def normalize(self, text):
        text = str(text or "").lower()

        replacements = {
            "أ": "ا",
            "إ": "ا",
            "آ": "ا",
            "ى": "ي",
            "ة": "ه",
        }

        for a, b in replacements.items():
            text = text.replace(a, b)

        return " ".join(text.split())

    # =========================================================
    # TOKENIZATION
    # =========================================================

    def meaningful_words(self, text):
        text = self.normalize(text)

        stop_words = {
            "ما", "هو", "هي", "هل", "من",
            "كيف", "ماذا", "لماذا", "متى",
            "اين", "أين", "في", "من",
            "على", "الى", "إلى", "عن",
            "مع", "و", "او", "أو",
            "لي", "ني", "انا", "أنا",
            "يمكن", "يستطيع",

            "the", "what", "is", "how",
            "why", "who", "when", "where",
            "can", "does", "do", "a", "an",

            "فيه", "به", "هذه", "هذا",
            "ذلك", "تلك", "بين",
        }

        return [
            word
            for word in text.split()
            if word not in stop_words
            and len(word) >= 2
        ]

    # =========================================================
    # RELEVANCE
    # =========================================================

    def relevance(self, query, text):
        """
        Semantic-ish lexical relevance.

        Important:
        - Shared generic words such as "Quavron" alone are weak evidence.
        - Exact question matches remain strongest.
        - Important topic words such as مجانية/مدفوعة/سعر/منصة
          receive additional weight.
        - Unrelated learned knowledge must not become relevant merely
          because it belongs to the same domain.
        """

        q = self.normalize(query)
        t = self.normalize(text)

        if not q or not t:
            return 0

        q_words = self.meaningful_words(q)
        t_words = self.meaningful_words(t)

        if not q_words or not t_words:
            return 0

        qset = set(q_words)
        tset = set(t_words)

        # -----------------------------------------------------
        # Exact full text
        # -----------------------------------------------------

        if q == t:
            return 100

        # -----------------------------------------------------
        # Semantic/topic groups
        # -----------------------------------------------------

        topic_groups = {
            "platform": {
                "منصه", "منصة", "منصات",
                "quavron",
            },
            "pricing": {
                "مجاني", "مجانيه", "مجانية",
                "مدفوع", "مدفوعة", "مدفوعه",
                "سعر", "اسعار", "أسعار",
                "اشتراك", "اشتراكات",
                "خطه", "خطة", "خطط",
                "تكلفه", "تكلفة",
                "رسوم",
            },
            "ai": {
                "ذكاء", "ذكاء اصطناعي",
                "qai", "مساعد", "مساعد ذكي",
            },
            "learning": {
                "تعلم", "تعليم", "دوره", "دورة",
                "اختبار", "معرفه", "معرفة",
                "تعلمية", "تعلميه",
            },
        }

        query_topics = set()

        for topic, words in topic_groups.items():
            normalized_words = {
                self.normalize(word)
                for word in words
            }

            if any(word in qset for word in normalized_words):
                query_topics.add(topic)

        text_topics = set()

        for topic, words in topic_groups.items():
            normalized_words = {
                self.normalize(word)
                for word in words
            }

            if any(word in tset for word in normalized_words):
                text_topics.add(topic)

        # -----------------------------------------------------
        # Exact meaningful word matching
        # -----------------------------------------------------

        score = 0
        matched = 0

        for word in qset:
            if word in tset:
                matched += 1

                # Domain word alone is weak.
                if word in {
                    "quavron",
                    "منصه",
                    "منصة",
                }:
                    score += 8

                elif len(word) >= 5:
                    score += 30

                else:
                    score += 15

        # -----------------------------------------------------
        # Topic alignment
        # -----------------------------------------------------

        shared_topics = query_topics & text_topics

        for topic in shared_topics:
            if topic == "pricing":
                score += 35
            elif topic == "learning":
                score += 30
            elif topic == "ai":
                score += 20
            elif topic == "platform":
                score += 10

        # -----------------------------------------------------
        # Partial matching
        # -----------------------------------------------------

        for qword in qset:

            if len(qword) < 5:
                continue

            for tword in tset:

                if len(tword) < 5:
                    continue

                if qword == tword:
                    continue

                if qword in tword or tword in qword:
                    score += 5

        # -----------------------------------------------------
        # Coverage
        # -----------------------------------------------------

        coverage = matched / max(len(qset), 1)

        if len(qset) >= 4 and coverage < 0.30:
            score = min(score, 20)

        elif len(qset) >= 3 and coverage < 0.50:
            score = min(score, 35)

        elif len(qset) >= 2 and coverage < 0.50:
            score = min(score, 40)

        # -----------------------------------------------------
        # Strong protection against cross-topic contamination
        # -----------------------------------------------------

        if query_topics and text_topics:
            if not shared_topics:
                return 0

        # If the query contains a pricing topic, a document that
        # only talks about the platform is not enough.
        if "pricing" in query_topics and "pricing" not in text_topics:
            score = min(score, 35)

        # If the query is specifically about learning/testing,
        # unrelated platform knowledge must not score highly.
        if "learning" in query_topics and "learning" not in text_topics:
            score = min(score, 25)

        return min(score, 100)

    # =========================================================
    # COMPOUND QUERY DETECTION
    # =========================================================

    def is_compound_query(self, query):

        text = self.normalize(query)

        compound_words = [
            "قارن",
            "مقارنة",
            "الفرق",
            "ما الفرق",
            "ما هو الفرق",
            "أيهما",
            "افضل من",
            "مقابل",

            "compare",
            "comparison",
            "difference",
            "differences",
            "versus",
            "vs",
        ]

        return any(
            word in text
            for word in compound_words
        )

    # =========================================================
    # EXTRACT IMPORTANT CONCEPTS
    # =========================================================

    def extract_concepts(self, query):

        text = self.normalize(query)

        concepts = []

        # -----------------------------------------------------
        # Known Quavron concepts
        #
        # These are deliberately explicit. Later this can
        # become a dynamic concept/entity extractor.
        # -----------------------------------------------------

        known_concepts = [
            "qai",
            "quavron",
            "cloud ide",
            "marketplace",
            "cloud",
            "ide",
            "community",
            "dashboard",
            "hosting",
            "courses",
            "freelance",
            "analytics",
            "social hub",
            "cloud ide",
            "api",
        ]

        for concept in known_concepts:

            if concept in text:
                concepts.append(concept)

        # -----------------------------------------------------
        # Remove duplicates while preserving order
        # -----------------------------------------------------

        cleaned = []
        seen = set()

        for concept in concepts:

            key = self.normalize(concept)

            if key in seen:
                continue

            seen.add(key)
            cleaned.append(concept)

        return cleaned

    def _learning_relevance(self, query, stored_question, answer=""):
        """
        Relevance for supervisor-approved learning.

        Uses:
        1. normalized lexical matching
        2. concept aliases
        3. question intent
        4. topic protection

        The goal is to recognize paraphrases without allowing
        unrelated platform/domain questions to match.
        """

        import re

        query = str(query or "").strip()
        stored_question = str(stored_question or "").strip()
        answer = str(answer or "").strip()

        if not query or not stored_question:
            return 0

        def normalize_learning(value):
            value = self.normalize(value)
            value = value.lower()

            # Remove punctuation BEFORE tokenization.
            value = re.sub(
                r"""[؟?!.,،؛:;"'`()\[\]{}<>«»/\\|+*=#@%&^~`_-]+""",
                " ",
                value,
            )

            # Normalize common Arabic variants.
            replacements = {
                "أ": "ا",
                "إ": "ا",
                "آ": "ا",
                "ى": "ي",
                "ة": "ه",
            }

            for a, b in replacements.items():
                value = value.replace(a, b)

            words = []

            for word in value.split():
                if not word:
                    continue

                # Remove common Arabic definite/article prefixes.
                prefixes = (
                    "وال",
                    "بال",
                    "كال",
                    "فال",
                    "لل",
                    "ال",
                )

                changed = True

                while changed:
                    changed = False

                    for prefix in prefixes:
                        if (
                            word.startswith(prefix)
                            and len(word) > len(prefix) + 2
                        ):
                            word = word[len(prefix):]
                            changed = True
                            break

                # Normalize a few common forms.
                aliases = {
                    "اختبار": "اختبار",
                    "اختبارات": "اختبار",
                    "امتحان": "اختبار",
                    "امتحانات": "اختبار",

                    "دوره": "دوره",
                    "دورات": "دوره",

                    "تعلم": "تعلم",
                    "تعليم": "تعلم",
                    "التعلم": "تعلم",
                    "التعليم": "تعلم",

                    "منصه": "منصه",
                    "منصات": "منصه",

                    "اشرح": "شرح",
                    "شرح": "شرح",
                    "توضيح": "شرح",
                    "وضح": "شرح",

                    "تعمل": "عمل",
                    "يعمل": "عمل",
                    "عمل": "عمل",

                    "يمكن": "قدره",
                    "يستطيع": "قدره",
                    "تستطيع": "قدره",

                    "qai": "qai",
                    "qai؟": "qai",
                    "quavron": "quavron",
                    "quavron؟": "quavron",
                }

                word = aliases.get(word, word)

                if len(word) >= 2:
                    words.append(word)

            return set(words)

        q = normalize_learning(query)
        s = normalize_learning(stored_question)

        if not q or not s:
            return 0

        # -----------------------------------------------------
        # EXACT MATCH
        # -----------------------------------------------------

        if q == s:
            return 100

        # -----------------------------------------------------
        # QUESTION INTENT
        # -----------------------------------------------------

        def detect_intent(words):
            intents = set()

            if "اختبار" in words:
                intents.add("test")

            if "ما" in words and (
                "هي" in words or "هو" in words
            ):
                intents.add("definition")

            if (
                "كيف" in words
                or "عمل" in words
            ):
                intents.add("how")

            if (
                "هل" in words
                or "قدره" in words
            ):
                intents.add("capability")

            if "شرح" in words:
                intents.add("explanation")

            return intents

        query_intents = detect_intent(q)
        stored_intents = detect_intent(s)

        # -----------------------------------------------------
        # TOPIC / CONCEPT GROUPS
        # -----------------------------------------------------

        test_topic = {"اختبار"}
        course_topic = {"دوره", "تعلم"}
        platform_topic = {"منصه", "quavron"}
        qai_topic = {"qai"}

        query_test = bool(q & test_topic)
        stored_test = bool(s & test_topic)

        query_course = bool(q & course_topic)
        stored_course = bool(s & course_topic)

        query_platform = bool(q & platform_topic)
        stored_platform = bool(s & platform_topic)

        query_qai = bool(q & qai_topic)
        stored_qai = bool(s & qai_topic)

        # -----------------------------------------------------
        # HARD TOPIC PROTECTION
        # -----------------------------------------------------

        # A platform-specific test question is different from
        # a course-specific test question.
        #
        # Example:
        #   "ما هو الاختبار الرسمي لمنصة Quavron؟"
        # must NOT match:
        #   "ما هو الاختبار الرسمي لدورة تعلم QAI؟"
        #
        # The shared words "الاختبار الرسمي" are not enough.
        if (
            query_test
            and query_platform
            and stored_test
            and not query_course
        ):
            return 0

        # A platform question without a course/test topic must
        # not select a course-specific learning record.
        if (
            query_platform
            and not query_course
            and not query_test
            and stored_course
        ):
            return 0

        # A course/test record must not answer a pure platform
        # definition question.
        if (
            query_platform
            and not query_course
            and not query_test
            and stored_test
        ):
            return 0

        # Capability questions should not select a test record.
        if (
            "capability" in query_intents
            and stored_test
        ):
            return 0

        # -----------------------------------------------------
        # SHARED CONCEPTS
        # -----------------------------------------------------

        shared = q & s

        # Ignore very generic words when calculating coverage.
        generic = {
            "رسمي",
            "ما",
            "هي",
            "هو",
            "لي",
            "من",
            "الى",
            "في",
            "عن",
            "هل",
            "كيف",
        }

        q_specific = q - generic
        s_specific = s - generic

        shared_specific = q_specific & s_specific

        if not q_specific:
            return 0

        coverage = (
            len(shared_specific)
            / max(len(q_specific), 1)
        )

        # -----------------------------------------------------
        # CORE TOPIC BONUS
        # -----------------------------------------------------

        score = 0

        # Test + course is a very strong signature for this
        # type of supervisor learning record.
        if query_test and stored_test:
            score += 35

        if query_course and stored_course:
            score += 25

        if query_qai and stored_qai:
            score += 15

        # -----------------------------------------------------
        # LEXICAL COVERAGE
        # -----------------------------------------------------

        if coverage >= 0.80:
            score += 35
        elif coverage >= 0.60:
            score += 25
        elif coverage >= 0.40:
            score += 15
        elif coverage > 0:
            score += 5

        # -----------------------------------------------------
        # INTENT COMPATIBILITY
        # -----------------------------------------------------

        if query_intents & stored_intents:
            score += 10

        # Explanation of a test is still a test-related query.
        if (
            "explanation" in query_intents
            and stored_test
            and query_course
        ):
            score += 10

        # "How does the course work?" can reasonably retrieve
        # a supervisor test about the learning pipeline, but
        # with less confidence than an explicit test question.
        if (
            "how" in query_intents
            and stored_course
        ):
            score += 10

        # -----------------------------------------------------
        # ANSWER REINFORCEMENT
        # -----------------------------------------------------

        if answer:
            answer_words = normalize_learning(answer)
            answer_shared = q_specific & answer_words

            if answer_shared:
                score += min(
                    10,
                    len(answer_shared) * 5
                )

        return min(score, 100)

    # =========================================================
    # SINGLE SOURCE SEARCH
    # =========================================================

    def _search_one(self, query, limit=8):

        results = []

        # =====================================================
        # 1. LEARNED KNOWLEDGE
        # =====================================================

        try:

            learned_results = learning_retriever.search(
                query,
                limit=limit
            )

            for item in learned_results:

                text = item.get("answer", "")

                if not text:
                    continue

                question = item.get("question")

                if isinstance(question, dict):
                    question_values = [
                        str(value)
                        for value in question.values()
                        if value
                    ]
                    stored_question = " | ".join(question_values)
                else:
                    stored_question = str(question or "")

                # Supervisor learning:
                # use the stored question as the primary relevance signal.
                rel = self._learning_relevance(
                    query,
                    stored_question,
                    text
                )

                results.append({
                    "text": text,
                    "score": (
                        SOURCE_PRIORITY["qai_learning"]
                        + item.get("score", 0)
                    ),
                    "relevance": rel,
                    "source": "qai_learning",
                    "teacher": item.get("teacher"),
                    "confidence": item.get(
                        "confidence",
                        0
                    ),
                    "approved": item.get(
                        "approved",
                        False
                    ),
                    "question": question,
                })

        except Exception as e:

            print(
                "learning retrieval error:",
                e
            )

        # =====================================================
        # 2. OFFICIAL KNOWLEDGE
        # =====================================================

        try:

            knowledge_results = search_engine.search(
                query
            )

            for item in knowledge_results:

                value = item.get("value")

                text = ""

                if isinstance(value, dict):

                    content = value.get("content")

                    if isinstance(content, dict):

                        text = (
                            content.get("ar")
                            or content.get("en")
                            or content.get("fr")
                            or ""
                        )

                    elif content:

                        text = str(content)

                    else:

                        title = value.get("title")

                        if isinstance(title, dict):

                            text = (
                                title.get("ar")
                                or title.get("en")
                                or title.get("fr")
                                or ""
                            )

                        elif title:

                            text = str(title)

                elif value:

                    text = str(value)

                if not text:
                    continue

                rel = self.relevance(
                    query,
                    text
                )

                item_question = item.get(
                    "question"
                )

                if isinstance(item_question, dict):

                    for value in item_question.values():

                        rel = max(
                            rel,
                            self.relevance(
                                query,
                                value
                            )
                        )

                results.append({
                    "text": text,
                    "score": (
                        SOURCE_PRIORITY["knowledge"]
                        + item.get("score", 0)
                    ),
                    "relevance": rel,
                    "source": "knowledge",
                    "confidence": item.get(
                        "confidence",
                        0
                    ),
                })

        except Exception as e:

            print(
                "knowledge error:",
                e
            )

        # =====================================================
        # 3. VECTOR MEMORY
        # =====================================================

        try:

            vector_results = search.search(
                query
            )

            for item in vector_results:

                text = item.get(
                    "text",
                    ""
                )

                if not text:
                    continue

                rel = self.relevance(
                    query,
                    text
                )

                results.append({
                    "text": text,
                    "score": (
                        SOURCE_PRIORITY["vector"]
                        + item.get("score", 0)
                    ),
                    "relevance": rel,
                    "source": "vector",
                })

        except Exception as e:

            print(
                "vector retrieval error:",
                e
            )

        return results

    # =========================================================
    # FILTER + RANK
    # =========================================================

    def _rank_and_clean(self, results):

        filtered = []

        for item in results:

            relevance = float(
                item.get(
                    "relevance",
                    0
                ) or 0
            )

            # Strong result
            if relevance >= 40:

                filtered.append(item)
                continue

            # -----------------------------------------------------
            # Approved supervisor learning
            # -----------------------------------------------------
            if (
                item.get("source") == "qai_learning"
                and item.get("approved", False) is True
                and float(item.get("confidence", 0) or 0) >= 1.0
                and relevance >= 20
            ):
                filtered.append(item)
                continue

            # Medium result allowed for trusted knowledge
            if (
                relevance >= 20
                and item.get("source") in {
                    "qai_learning",
                    "knowledge",
                }
            ):

                filtered.append(item)

        # -----------------------------------------------------
        # Calculate final score
        # -----------------------------------------------------

        for item in filtered:

            relevance = float(
                item.get(
                    "relevance",
                    0
                ) or 0
            )

            item["final_score"] = (
                relevance * 20
                + item.get("score", 0)
            )

        # -----------------------------------------------------
        # Ranking
        # -----------------------------------------------------

        filtered.sort(
            key=lambda x: (
                x.get("relevance", 0),
                x.get("final_score", 0),
                x.get("score", 0)
            ),
            reverse=True
        )

        # -----------------------------------------------------
        # Deduplication
        # -----------------------------------------------------

        cleaned = []
        seen = set()

        for item in filtered:

            text = item.get(
                "text",
                ""
            ).strip()

            if not text:
                continue

            fingerprint = self.normalize(
                text
            )

            if fingerprint in seen:
                continue

            seen.add(fingerprint)

            cleaned.append(item)

        return cleaned

    # =========================================================
    # MAIN RETRIEVAL
    # =========================================================

    def retrieve(self, query, limit=8):

        query = str(query or "").strip()

        if not query:
            return []

        # =====================================================
        # 1. NORMAL DIRECT SEARCH
        # =====================================================

        direct_results = self._search_one(
            query,
            limit=limit
        )

        # =====================================================
        # 2. COMPOUND QUERY SEARCH
        #
        # Example:
        #
        # "قارن بين Cloud IDE و Marketplace"
        #
        # Search independently for:
        #
        # Cloud IDE
        # Marketplace
        # Quavron
        # =====================================================

        if self.is_compound_query(query):

            concepts = self.extract_concepts(
                query
            )

            for concept in concepts:

                concept_results = self._search_one(
                    concept,
                    limit=limit
                )

                for item in concept_results:

                    # Mark that this came from
                    # concept-level retrieval.
                    item["retrieval_query"] = concept

                    direct_results.append(item)

        # =====================================================
        # 3. RANK
        # =====================================================

        cleaned = self._rank_and_clean(
            direct_results
        )

        # =====================================================
        # 4. COMPOUND QUERY BALANCING
        #
        # Do not allow one concept to completely dominate
        # the context.
        # =====================================================

        if self.is_compound_query(query):

            concepts = self.extract_concepts(
                query
            )

            balanced = []

            # First collect the best result for each
            # detected concept.
            for concept in concepts:

                concept_norm = self.normalize(
                    concept
                )

                candidates = [
                    item
                    for item in cleaned
                    if concept_norm in self.normalize(
                        item.get("text", "")
                    )
                    or item.get(
                        "retrieval_query"
                    ) == concept
                ]

                if candidates:

                    balanced.append(
                        candidates[0]
                    )

            # Then add remaining best results.
            used = {
                self.normalize(
                    item.get("text", "")
                )
                for item in balanced
            }

            for item in cleaned:

                fingerprint = self.normalize(
                    item.get("text", "")
                )

                if fingerprint in used:
                    continue

                balanced.append(item)
                used.add(fingerprint)

            cleaned = balanced

        return cleaned[:limit]


retriever = Retriever()
